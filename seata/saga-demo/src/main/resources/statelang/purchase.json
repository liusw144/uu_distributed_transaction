    "AfterAccount": {
      "Type": "ServiceTask",
      "ServiceName": "sagaParticipant",
      "ServiceMethod": "afterAccount",
      "IsForUpdate": false,
      "Next": "Succeed",
      "Input": [
        "$.[p]"
      ],
      "Status": {
        "#root == true": "SU",
        "$Exception{java.lang.Throwable}": "FA"
      },
      "Catch": [
        {
          "Exceptions": [
            "java.lang.Throwable"
          ],
          "Next": "Compensate"
        }
      ]
    },
    "Compensate": {
      "Type": "CompensationTrigger",
      "Next": "Fail"
    },
    "Fail": {
      "Type": "Fail",
      "ErrorCode": "PURCHASE_FAILED",
      "Message": "Purchase failed; inspect compensationStatus"
    },
    "Succeed": {
      "Type": "Succeed"
    }
  }
}
# 启动模块后按顺序 Run All Requests；每轮修改 run，库存/余额不足时显式补充专用资源。
@host = http://127.0.0.1:8104
@run = manual-001


### 记录两库基线
GET {{host}}/api/seata/saga/state

> {%
    client.test("查询基线", function () {
        client.assert(response.status === 200);
        client.global.set("sagaStock", String(response.body.stock.find(x => x.id === "p1").available));
        client.global.set("sagaBalance", String(response.body.accounts.find(x => x.id === "u1").balance));
    });
%}


### 成功，保存官方实例 ID
POST {{host}}/api/seata/saga/orders
Content-Type: application/json

{"orderId":"sg-{{run}}-ok","userId":"u1","productId":"p1","quantity":2,"unitPrice":10.00,"failAt":"NONE"}

> {%
    client.test("官方引擎成功", function () {
        client.assert(response.status === 200);
        client.assert(response.body.status === "SU");
        client.assert(response.body.compensationStatus === "NONE");
        client.global.set("sagaOkId", response.body.id);
    });
%}


### 重复同 payload 返回相同实例
POST {{host}}/api/seata/saga/orders
Content-Type: application/json

{"orderId":"sg-{{run}}-ok","userId":"u1","productId":"p1","quantity":2,"unitPrice":10.00,"failAt":"NONE"}

> {%
    client.test("请求幂等", function () {
        client.assert(response.status === 200);
        client.assert(response.body.id === client.global.get("sagaOkId"));
    });
%}


### 同业务号换数量拒绝
POST {{host}}/api/seata/saga/orders
Content-Type: application/json

{"orderId":"sg-{{run}}-ok","userId":"u1","productId":"p1","quantity":3,"unitPrice":10.00,"failAt":"NONE"}

> {%
    client.test("payload冲突", function () {
        client.assert(response.status === 409);
    });
%}


### 恢复接口不能取消成功实例
POST {{host}}/api/seata/saga/instances/{{sagaOkId}}/compensate

> {%
    client.test("拒绝取消成功订单", function () {
        client.assert(response.status === 409);
    });
%}


### AFTER_ORDER，已提交动作由官方引擎逆向补偿
POST {{host}}/api/seata/saga/orders
Content-Type: application/json

{"orderId":"sg-{{run}}-order","userId":"u1","productId":"p1","quantity":2,"unitPrice":10.00,"failAt":"AFTER_ORDER"}

> {%
    client.test("失败并完成业务补偿", function () {
        client.assert(response.status === 200);
        client.assert(response.body.status !== "SU");
        client.assert(response.body.compensationStatus === "SU");
    });
%}


### AFTER_STOCK，已提交动作由官方引擎逆向补偿
POST {{host}}/api/seata/saga/orders
Content-Type: application/json

{"orderId":"sg-{{run}}-stock","userId":"u1","productId":"p1","quantity":2,"unitPrice":10.00,"failAt":"AFTER_STOCK"}

> {%
    client.test("失败并完成业务补偿", function () {
        client.assert(response.status === 200);
        client.assert(response.body.status !== "SU");
        client.assert(response.body.compensationStatus === "SU");
    });
%}


### AFTER_ACCOUNT，已提交动作由官方引擎逆向补偿
POST {{host}}/api/seata/saga/orders
Content-Type: application/json

{"orderId":"sg-{{run}}-account","userId":"u1","productId":"p1","quantity":2,"unitPrice":10.00,"failAt":"AFTER_ACCOUNT"}

> {%
    client.test("失败并完成业务补偿", function () {
        client.assert(response.status === 200);
        client.assert(response.body.status !== "SU");
        client.assert(response.body.compensationStatus === "SU");
    });
%}


### 余额不足
POST {{host}}/api/seata/saga/orders
Content-Type: application/json

{"orderId":"sg-{{run}}-poor","userId":"u1","productId":"p1","quantity":1,"unitPrice":1000000.00,"failAt":"NONE"}

> {%
    client.test("余额不足也完成补偿", function () {
        client.assert(response.status === 200);
        client.assert(response.body.status !== "SU");
        client.assert(response.body.compensationStatus === "SU");
    });
%}


### 库存不足
POST {{host}}/api/seata/saga/orders
Content-Type: application/json

{"orderId":"sg-{{run}}-empty","userId":"u1","productId":"p1","quantity":1000,"unitPrice":0.01,"failAt":"NONE"}

> {%
    client.test("库存不足也完成补偿", function () {
        client.assert(response.status === 200);
        client.assert(response.body.status !== "SU");
        client.assert(response.body.compensationStatus === "SU");
    });
%}


### 安排 ACCOUNT 下一次补偿在本地提交前失败
POST {{host}}/api/seata/saga/faults/sg-{{run}}-recover/ACCOUNT

> {%
    client.test("故障已设置", function () {
        client.assert(response.status === 200);
    });
%}


### 正向三步完成后失败，账户补偿暂时失败
POST {{host}}/api/seata/saga/orders
Content-Type: application/json

{"orderId":"sg-{{run}}-recover","userId":"u1","productId":"p1","quantity":2,"unitPrice":10.00,"failAt":"AFTER_ACCOUNT"}

> {%
    client.test("失败补偿可观测", function () {
        client.assert(response.status === 200);
        client.assert(response.body.compensationStatus !== "SU");
        client.global.set("sagaRecoverId", response.body.id);
    });
%}


### 查询持久化实例（可在此手工重启应用）
GET {{host}}/api/seata/saga/instances/{{sagaRecoverId}}

> {%
    client.test("持久化失败状态仍可查", function () {
        client.assert(response.status === 200);
        client.assert(response.body.compensationStatus !== "SU");
    });
%}


### 使用持久化实例恢复补偿
POST {{host}}/api/seata/saga/instances/{{sagaRecoverId}}/compensate

> {%
    client.test("补偿恢复成功", function () {
        client.assert(response.status === 200);
        client.assert(response.body.compensationStatus === "SU");
    });
%}


### 重复补偿不重复退款
POST {{host}}/api/seata/saga/instances/{{sagaRecoverId}}/compensate

> {%
    client.test("重复补偿幂等", function () {
        client.assert(response.status === 200);
        client.assert(response.body.compensationStatus === "SU");
    });
%}


### 安排补偿提交成功但丢响应
POST {{host}}/api/seata/saga/faults/sg-{{run}}-ack/ACCOUNT?loseAck=true

> {%
    client.test("丢响应故障已设置", function () {
        client.assert(response.status === 200);
    });
%}


### 补偿已提交，状态尚不确定
POST {{host}}/api/seata/saga/orders
Content-Type: application/json

{"orderId":"sg-{{run}}-ack","userId":"u1","productId":"p1","quantity":2,"unitPrice":10.00,"failAt":"AFTER_ACCOUNT"}

> {%
    client.test("补偿丢响应可观测", function () {
        client.assert(response.status === 200);
        client.assert(response.body.compensationStatus !== "SU");
        client.global.set("sagaAckId", response.body.id);
    });
%}


### 重试已提交的补偿
POST {{host}}/api/seata/saga/instances/{{sagaAckId}}/compensate

> {%
    client.test("丢响应后重试幂等", function () {
        client.assert(response.status === 200);
        client.assert(response.body.compensationStatus === "SU");
    });
%}


### 参数验证
POST {{host}}/api/seata/saga/orders
Content-Type: application/json

{"orderId":"sg-{{run}}-invalid","userId":"u1","productId":"p1","quantity":0,"unitPrice":10.00,"failAt":"NONE"}

> {%
    client.test("数量非法", function () {
        client.assert(response.status === 400);
    });
%}


### 最终资源及所有失败订单状态断言
GET {{host}}/api/seata/saga/state

> {%
    client.test("只有一个成功订单造成扣减", function () {
        client.assert(response.status === 200);
        client.assert(Number(response.body.stock.find(x => x.id === "p1").available) === Number(client.global.get("sagaStock")) - 2);
        client.assert(Number(response.body.accounts.find(x => x.id === "u1").balance) === Number(client.global.get("sagaBalance")) - 20);
        const run = request.variables.get('run');
        for (const suffix of ["order", "stock", "account", "poor", "empty", "recover", "ack"]) {
            const action = response.body.orders.find(x => x.tx_id === "sg-" + run + "-" + suffix);
            client.assert(action && action.state === "COMPENSATED", "失败订单必须已补偿：" + suffix);
        }
        client.assert(response.body.orders.find(x => x.tx_id === "sg-" + run + "-ok").state === "APPLIED");
    });
%}
